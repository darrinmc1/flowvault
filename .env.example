# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com
RESEND_REPLY_TO=

# Site
NEXT_PUBLIC_SITE_DOMAIN=yourdomain.com
NEXT_PUBLIC_SITE_NAME=FlowVault
NOTIFY_EMAIL=you@yourdomain.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Public contact address. Leave blank to show no email on the site.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Stripe — TTPN Pty Ltd, test mode.
# Both flags must be the string "true" or checkout and the webhook return 503.
# They default to off when unset. STRIPE_SECRET_KEY is the TTPN test secret.
# Never commit secret values. Prebuilt Checkout does not need a publishable key.
# Prices are looked up by lookup_key (for example flowvault_drafter_once_usd69).
STRIPE_ENABLED=false
NEXT_PUBLIC_STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SITE_KEY=flowvault

# Mailchimp (fallback newsletter)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Site key (used for multi-tenant Supabase rows)
SITE_KEY=
