# ── Clerk (auth) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Supabase (entitlements + downloads) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (checkout + webhooks) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Mailchimp (direct-submit popup — action URL goes in waitlist-popup.tsx) ───
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SITE_TAG=

# ── Resend (transactional email) ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=noreply@example.com
RESEND_REPLY_TO=
NOTIFY_EMAIL=

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=
SITE_KEY=

# Canonical domain for sitemap + OG tags (no protocol). Falls back to Vercel URL, then site.config domain.
NEXT_PUBLIC_SITE_DOMAIN=
# Show GitHub link in footer (set "true" to show; unset/false hides it)
NEXT_PUBLIC_SHOW_GITHUB_FOOTER=
